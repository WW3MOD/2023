<Project>
  <!--
    Atomic-replace shim for engine/bin/ output on Unix.

    Problem: macOS/Linux let you overwrite files that another process has open.
    .NET mmaps assembly DLLs into the running game's address space, so an
    in-place rewrite of engine/bin/*.dll while the game is running corrupts
    those mapped pages and crashes the game (signature: "Cannot print
    exception string because Exception.ToString() failed" + Abort trap 6).

    Fix: unlink each output file before MSBuild's Copy task runs. unlink(2)
    removes the directory entry but keeps the inode alive as long as any
    process holds a reference (mmap, fd, etc.). The running game keeps
    reading its old inode; the next Copy creates a brand-new inode at the
    same path for future launches. No torn writes, no crash.

    No-op on Windows: the OS already locks loaded DLLs at the kernel level,
    so the build fails fast there if the game is running. The Condition
    below skips this target entirely on Windows, leaving that behavior
    untouched.
  -->
  <!--
    Two hooks needed: CopyFilesToOutputDirectory copies via DependsOnTargets,
    one of which (_CopyFilesMarkedCopyLocal) copies third-party deps BEFORE
    a BeforeTargets="CopyFilesToOutputDirectory" hook fires. Hooking the
    sub-target directly catches dep copies; hooking the parent catches the
    project's own assembly + pdb.
  -->
  <Target Name="UnlinkReferenceCopiesForMmapSafety"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(OS)' != 'Windows_NT'">
    <!--
      Skip items whose source path equals the destination path: projects that
      share $(OutDir) (OpenRA.Launcher/Utility referencing OpenRA.Game) end up
      with same-path "copies" that MSBuild treats as no-ops. Deleting those
      would remove the file before the no-op runs, breaking the build.
    -->
    <ItemGroup>
      <_MmapSafetyCandidate Include="@(ReferenceCopyLocalPaths)">
        <SourcePath>%(ReferenceCopyLocalPaths.FullPath)</SourcePath>
        <DestPath>$([System.IO.Path]::GetFullPath('$(OutDir)%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)'))</DestPath>
      </_MmapSafetyCandidate>
      <_MmapSafetyDeps Include="%(_MmapSafetyCandidate.DestPath)"
                       Condition="'%(_MmapSafetyCandidate.SourcePath)' != '%(_MmapSafetyCandidate.DestPath)'" />
    </ItemGroup>
    <Delete Files="@(_MmapSafetyDeps)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="UnlinkProjectOutputForMmapSafety"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_MmapSafetyOwn Include="$(TargetDir)$(TargetFileName)" />
      <_MmapSafetyOwn Include="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(_MmapSafetyOwn)" TreatErrorsAsWarnings="true" />
  </Target>

  <!--
    Stamp the git revision of the sources being compiled into OpenRA.Game as an
    [AssemblyMetadata("BuildRevision", ...)] attribute, read back at runtime by
    OpenRA.Network.BuildFingerprint and compared during the join handshake.

    Why a build-time stamp and not a runtime hash of the .cs files: C# is compiled.
    The running binary is whatever was on disk when it was last compiled, so a
    working tree that has moved on since (checked out a new commit, edited a trait)
    must NOT change the reported revision - it would claim a difference that the
    running code does not have, and worse, would hide the reverse case.

    Why not hash the built assemblies instead: C# compilation is not byte-
    reproducible (each build gets a fresh MVID, and absolute source paths are
    embedded), so two machines compiling identical sources would disagree forever
    and nobody could ever join anybody.

    Dirty trees are covered: uncommitted changes under engine/ append a hash of
    `git diff HEAD` (actual content, so two people editing the same file
    differently do not collide) plus the porcelain status list (which catches
    untracked new files that a diff cannot see).

    The pathspec is engine/ ONLY, deliberately. Two reasons, and the second is
    the important one:
      1. mods/ yaml is already hashed at RUN time by BuildFingerprint's rules
         segment, which is strictly better measurement - it sees the file that
         actually gets loaded, not the one that happened to be on disk at the
         last compile.
      2. This stamp is a Compile input, so anything that moves it recompiles the
         engine. With mods/ in the pathspec a single untracked file under mods/
         flipped the revision, which turned a YAML-only edit into a full engine
         rebuild (6.3 s vs 3.1 s) - and per CLAUDE.md that build fails fast on
         Windows while the game holds the DLLs, breaking the edit-YAML-while-
         playing loop.
    Known gap accepted in exchange: an UNCOMMITTED change to a repo-tracked
    binary asset under mods/ (a .shp, a .png) is invisible to the fingerprint.
    Committing it moves HEAD and is caught; the yaml is caught either way.

    Every git call is ContinueOnError: no git, or a source zip rather than a clone,
    degrades to the literal "unknown" rather than failing the build.
  -->
  <Target Name="StampBuildRevision"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectName)' == 'OpenRA.Game'">
    <PropertyGroup>
      <_RevisionRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_RevisionRepoRoot>
    </PropertyGroup>

    <Exec Command="git -C &quot;$(_RevisionRepoRoot)&quot; rev-parse --short=10 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RevisionCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_RevisionCommitExit" />
    </Exec>

    <Exec Command="git -C &quot;$(_RevisionRepoRoot)&quot; status --porcelain --untracked-files=all -- engine"
          Condition="'$(_RevisionCommitExit)' == '0'"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RevisionStatus" />
    </Exec>

    <!-- Only pay for the diff when the status already says something changed. -->
    <Exec Command="git -C &quot;$(_RevisionRepoRoot)&quot; diff HEAD --no-ext-diff --binary -- engine | git hash-object --stdin"
          Condition="'$(_RevisionStatus)' != ''"
          ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RevisionDiff" />
    </Exec>

    <Hash ItemsToHash="$(_RevisionStatus);$(_RevisionDiff)" Condition="'$(_RevisionStatus)' != ''">
      <Output TaskParameter="HashResult" PropertyName="_RevisionDirtyHash" />
    </Hash>

    <PropertyGroup>
      <_BuildRevision Condition="'$(_RevisionCommitExit)' != '0' or '$(_RevisionCommit)' == ''">unknown</_BuildRevision>
      <_BuildRevision Condition="'$(_BuildRevision)' == '' and '$(_RevisionStatus)' == ''">$(_RevisionCommit)</_BuildRevision>
      <_BuildRevision Condition="'$(_BuildRevision)' == ''">$(_RevisionCommit)+$(_RevisionDirtyHash.Substring(0, 8))</_BuildRevision>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildRevision</_Parameter1>
        <_Parameter2>$(_BuildRevision)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
