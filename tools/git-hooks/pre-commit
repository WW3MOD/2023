#!/bin/bash
# WW3MOD pre-commit hook.
#
# Checks staged C# files for newly added Console.Write / Console.WriteLine — these flood
# stdout when called from tick-path traits/activities. Use Log.Write(channel, ...) instead.
#
# An allowlist below covers files where Console output is legitimate (utility commands,
# linters, the standalone server, tests). To extend the allowlist, append a regex
# fragment to ALLOWLIST_PATTERNS.
#
# Install:  ln -sf ../../tools/git-hooks/pre-commit .git/hooks/pre-commit

set -e

ALLOWLIST_PATTERNS=(
    'UtilityCommands/'
    'UpdateRules/'
    '/Lint/'
    'OpenRA\.Server/'
    'OpenRA\.Test/'
    'OpenRA\.Utility/'
    'tools/'
    # TestMode.cs is the test/skirmish-mode entry point — its Console.Write calls
    # fire at most once per game launch (Initialize) + once per result write, not
    # in tick path. Adding allowlist entry so future edits to surrounding code
    # don't trip the hook.
    'OpenRA\.Game/TestMode\.cs'
    # TestModeScreenshots.cs is the screenshot capture coordinator — same
    # one-shot pattern (Initialize once, capture once per Test.Screenshot call,
    # not on every tick).
    'OpenRA\.Game/TestModeScreenshots\.cs'
)

ALLOW_REGEX=$(IFS='|'; echo "${ALLOWLIST_PATTERNS[*]}")

# Passed through the ENVIRONMENT rather than `awk -v`, deliberately. A -v assignment
# undergoes escape processing first, so a `\.` written naturally in the array above
# reaches awk as a bare `.` — awk warns "escape sequence \. treated as plain ." on
# every single commit, and the dots silently degrade into match-anything wildcards.
# ENVIRON is passed verbatim, so the patterns mean exactly what they say and stay
# readable with single backslashes, which is what the comment at the top tells a
# future contributor to write.
violations=$(git diff --cached --diff-filter=AM -U0 -- '*.cs' | ALLOW_REGEX="$ALLOW_REGEX" awk '
    BEGIN { allow = ENVIRON["ALLOW_REGEX"] }
    /^diff --git/ { in_block = 0 }
    /^\+\+\+ b\// {
        path = substr($0, 7)
        allowed = (path ~ allow) ? 1 : 0
        in_block = 1
        next
    }
    in_block && !allowed && /^\+[^+].*Console\.Write/ {
        line = substr($0, 2)
        sub(/^[ \t]+/, "", line)
        print path ":   " line
    }
')

if [ -n "$violations" ]; then
    echo ""
    echo "PITFALL: new Console.Write in tick-path engine code (causes log spam every tick):"
    echo ""
    echo "$violations" | sed 's/^/  /'
    echo ""
    echo "Use Log.Write(channel, ...) for runtime logging."
    echo "For legit utility/CLI code, add a path fragment to ALLOWLIST_PATTERNS in tools/git-hooks/pre-commit."
    echo ""
    exit 1
fi

# CRLF backstop.
#
# .gitattributes now normalizes text to LF via `* text=auto eol=lf` in BOTH the repo
# root and engine/, so CRLF should be structurally unable to enter the index. This
# check exists because that guarantee has silently failed before: the old `* text=lf`
# was a no-op ("lf" is not a valid `text` value), and a Python writer using the
# platform default newline put 2276 CR bytes into WORKSPACE/DISCOVERIES.md on
# 2026-08-05 with nothing complaining. If the attributes ever regress, this fails the
# commit instead of letting the damage land.
#
# Reads the STAGED blob, not the working tree, so it sees exactly what would be
# committed. Binary files are skipped via git's own text/binary attribute.
crlf_files=""
while IFS= read -r path; do
    [ -z "$path" ] && continue
    # Skip anything git considers binary (attribute `text` unset, e.g. *.png *.shp).
    case "$(git check-attr text -- "$path")" in
        *": text: unset") continue ;;
    esac
    if git show ":$path" 2>/dev/null | grep -qU $'\r'; then
        crlf_files="$crlf_files  $path"$'\n'
    fi
done < <(git diff --cached --name-only --diff-filter=AM)

if [ -n "$crlf_files" ]; then
    echo ""
    echo "CRLF line endings in staged text files — this repository is LF-only:"
    echo ""
    printf '%s' "$crlf_files"
    echo ""
    echo "Fix, then re-stage:  git add --renormalize <file>"
    echo "If a file is genuinely binary, pin it in .gitattributes (and engine/.gitattributes"
    echo "if it lives under engine/ — a deeper .gitattributes wins per-attribute)."
    echo ""
    exit 1
fi

exit 0
